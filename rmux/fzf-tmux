#!/bin/bash
# fzf-tmux for tmux-fzf under rmux (first on PATH for rmux's jobs). The
# plugin's own relays through mkfifo, which native fzf.exe can't open, so
# the popup ended at once; this passes the list and the pick in temp files.
# Takes fzf-tmux's -p, -w, -h, then fzf's options.
w=80% h=60%
while [ $# -gt 0 ]; do
    case $1 in
        -p) shift ;;
        -w | -h) [ "$1" = -w ] && w=$2 || h=$2; shift 2 ;;
        *) break ;;
    esac
done
in=$(mktemp) out=$(mktemp)
trap 'rm -f "$in" "$out"' EXIT
cat > "$in"
# popup returns at once; wait-for holds until fzf is done.
done=fzf-tmux-$$
tmux popup -E -w "$w" -h "$h" "fzf $(printf '%q ' "$@") < '$in' > '$out'; tmux wait-for -S $done"
tmux wait-for "$done"
cat "$out"
[ -s "$out" ]
